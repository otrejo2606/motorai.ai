# Copiar a photo-classifier.env (ignorado por git) y completar en la VM de IA. Nunca versionar el .env real.

# Etiqueta de la imagen construida, por ejemplo la fecha o el commit.
CLASSIFIER_IMAGE_TAG=

# Carpeta de la VM con los modelos exportados (training/export.py) y el archivo a servir.
MODELS_DIR=/opt/motoria/models
MODEL_FILE=
# Versión que viaja en cada respuesta (hasta 60 caracteres), la misma del .json exportado.
MODEL_VERSION=

# Dirección de la VM dentro del túnel WireGuard (10.90.0.0/24). Nunca la dirección pública.
WG_BIND_ADDRESS=

# Token Bearer opcional. Si se usa, generarlo en la VM (por ejemplo, 32 bytes aleatorios en hexadecimal)
# y poner el mismo valor en MOTORIA_PHOTO_CLASSIFIER_TOKEN del backend.
CLASSIFIER_TOKEN=

CLASSIFIER_CPUS=2
CLASSIFIER_MEMORY=2g
TOP_K=5
IMAGE_SIZE=224
LOG_LEVEL=INFO
