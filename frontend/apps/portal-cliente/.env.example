# Copiar a .env (ignorado por git). Sin secretos: el cliente de Keycloak es publico y usa PKCE.
VITE_API_BASE_URL=http://localhost:8080
VITE_OIDC_AUTHORITY=http://localhost:8180/realms/motoria
VITE_OIDC_CLIENT_ID=motoria-portal-cliente
VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
VITE_OIDC_SCOPE=openid profile email
# Roles del realm en el access token de Keycloak.
VITE_OIDC_ROLES_CLAIM=realm_access.roles
VITE_DEFAULT_COUNTRY=CR
VITE_DEFAULT_LANGUAGE=es
# Moneda por defecto del precio de un anuncio nuevo (CRC o USD).
VITE_CURRENCY=CRC
VITE_MAX_DOCUMENT_MB=10
VITE_MAX_PHOTO_MB=15
